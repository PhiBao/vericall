{
  "name": "vericall-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "VeriCall \u2014 SLA-verified software-to-software settlement on Arc, with automatic rebates and dependency splits.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "deploy": "node --experimental-strip-types --no-warnings scripts/deploy.ts",
    "register": "node --experimental-strip-types --no-warnings scripts/register.ts",
    "order": "node --experimental-strip-types --no-warnings scripts/order.ts",
    "settle": "node --experimental-strip-types --no-warnings scripts/settle.ts",
    "reclaim": "node --experimental-strip-types --no-warnings scripts/reclaim.ts",
    "verify": "node --experimental-strip-types --no-warnings scripts/verify.ts",
    "demo": "node --experimental-strip-types --no-warnings scripts/demo.ts",
    "plan": "node --experimental-strip-types --no-warnings scripts/plan-covenants.ts",
    "bond": "node --experimental-strip-types --no-warnings scripts/bond.ts",
    "test:wallet": "node --experimental-strip-types --no-warnings scripts/test-wallet.ts",
    "test": "pnpm typecheck && pnpm test:wallet",
    "demo:outage": "node --experimental-strip-types --no-warnings scripts/demo-outage.ts",
    "wallet": "node --experimental-strip-types --no-warnings tools/demo-wallet.ts",
    "test:settle-ui": "node --experimental-strip-types --no-warnings scripts/test-settle-ui.ts"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
