{
  "$comment": "The published services, as one source of truth. The Rust verifier embeds this file with include_str! and the TypeScript tooling reads it, so the terms a covenant is registered with are the terms the verifier prices against and the schemas it validates against. `schema` is the JSON Schema a passing response must satisfy, stored as a real object rather than an escaped string: both sides canonicalise the parsed value, so the hash each computes is the same by construction.",
  "services": [
    {
      "slug": "risk-scorer",
      "name": "Counterparty Risk Scorer",
      "summary": "Scores a counterparty from sanctions and adverse-media signals before a payment is released.",
      "path": "/mock/risk-scorer",
      "backedBy": "deterministic",
      "backing": "Served by the verifier from a fixed signal set so the settlement arithmetic can be exercised without depending on a third party.",
      "schema": {
        "type": "object",
        "required": ["score", "band", "checks", "asOf"],
        "properties": {
          "score": { "type": "number", "minimum": 0, "maximum": 100 },
          "band": { "type": "string", "enum": ["low", "medium", "high"] },
          "checks": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "asOf": { "type": "integer", "minimum": 1 }
        },
        "additionalProperties": false
      },
      "priceUsdc": "0.2",
      "graceLatencyMs": 500,
      "hardTimeoutMs": 2000,
      "maxRebateBps": 4000,
      "slashPenaltyBps": 2000,
      "providerBps": 8000,
      "initialBondUsdc": "0.1"
    },
    {
      "slug": "invoice-parser",
      "name": "Invoice Field Extractor",
      "summary": "Turns a PDF or email invoice into typed fields a payment run can act on.",
      "path": "/mock/invoice-parser",
      "backedBy": "deterministic",
      "backing": "Served by the verifier from fixed input so the settlement arithmetic can be exercised without depending on a third party.",
      "schema": {
        "type": "object",
        "required": ["invoiceId", "currency", "amount", "lines"],
        "properties": {
          "invoiceId": { "type": "string", "pattern": "^INV-[0-9]{4,}$" },
          "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
          "amount": { "type": "integer", "minimum": 1 },
          "lines": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["sku", "amount"],
              "properties": {
                "sku": { "type": "string", "minLength": 3 },
                "amount": { "type": "integer", "minimum": 1 }
              }
            }
          }
        },
        "additionalProperties": false
      },
      "priceUsdc": "0.15",
      "graceLatencyMs": 400,
      "hardTimeoutMs": 1500,
      "maxRebateBps": 5000,
      "slashPenaltyBps": 2500,
      "providerBps": 7000,
      "initialBondUsdc": "0.1"
    },
    {
      "slug": "ast-auditor",
      "name": "Contract Surface Auditor",
      "summary": "Reports the external surface and risky patterns of a Solidity source file.",
      "path": "/mock/ast-auditor",
      "backedBy": "deterministic",
      "backing": "Served by the verifier from fixed input so the settlement arithmetic can be exercised without depending on a third party.",
      "schema": {
        "type": "object",
        "required": ["contractName", "highRisk", "findings"],
        "properties": {
          "contractName": { "type": "string", "minLength": 1 },
          "highRisk": { "type": "integer", "minimum": 0 },
          "findings": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["rule", "severity"],
              "properties": {
                "rule": { "type": "string" },
                "severity": { "type": "string", "enum": ["info", "low", "medium", "high", "critical"] }
              }
            }
          }
        },
        "additionalProperties": false
      },
      "priceUsdc": "0.5",
      "graceLatencyMs": 1000,
      "hardTimeoutMs": 3000,
      "maxRebateBps": 3000,
      "slashPenaltyBps": 1500,
      "providerBps": 9000,
      "initialBondUsdc": "0.2"
    },
    {
      "slug": "intent-router",
      "name": "Payment Intent Router",
      "summary": "Reads a natural-language payment instruction and returns a typed intent with calibrated probabilities.",
      "path": "/mock/intent-router",
      "backedBy": "jev",
      "backing": "One TypeSafe Jev request: a Choice over the closed set of intents, two Nouls for presence, a Score for urgency, and a Noul for whether a human must authorise it. The response is a typed answer, not generated text, which is what makes a schema over it meaningful: the covenant requires probabilities, and a model that returns prose could not satisfy it.",
      "schema": {
        "type": "object",
        "required": ["intent", "choices", "confidence", "amountStated", "counterpartyStated", "urgency", "needsHumanReview"],
        "properties": {
          "intent": {
            "type": "string",
            "enum": ["pay_invoice", "split_payment", "schedule_payment", "query_balance", "unknown"]
          },
          "choices": {
            "type": "object",
            "required": ["pay_invoice", "split_payment", "schedule_payment", "query_balance", "unknown"],
            "properties": {
              "pay_invoice": { "type": "number", "minimum": 0, "maximum": 1 },
              "split_payment": { "type": "number", "minimum": 0, "maximum": 1 },
              "schedule_payment": { "type": "number", "minimum": 0, "maximum": 1 },
              "query_balance": { "type": "number", "minimum": 0, "maximum": 1 },
              "unknown": { "type": "number", "minimum": 0, "maximum": 1 }
            },
            "additionalProperties": false
          },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "amountStated": { "type": "number", "minimum": 0, "maximum": 1 },
          "counterpartyStated": { "type": "number", "minimum": 0, "maximum": 1 },
          "urgency": { "type": "number", "minimum": 0, "maximum": 2 },
          "needsHumanReview": { "type": "number", "minimum": 0, "maximum": 1 },
          "missing": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      },
      "priceUsdc": "0.05",
      "graceLatencyMs": 2500,
      "hardTimeoutMs": 10000,
      "maxRebateBps": 4000,
      "slashPenaltyBps": 2000,
      "providerBps": 8000,
      "initialBondUsdc": "0.02"
    },
    {
      "slug": "payment-guard",
      "name": "Payment Policy Guard",
      "summary": "Screens a proposed payment against a bounded set of hazards and returns a verdict with the probabilities behind it.",
      "path": "/mock/payment-guard",
      "backedBy": "jev",
      "backing": "One TypeSafe Jev request asking five hazard questions (amount, counterparty, duplication, urgency pressure, restricted party) plus a severity Score. The verdict is computed in code from explicit thresholds, following the guardrails pattern: the model supplies probabilities, the policy stays visible and changeable without another inference.",
      "schema": {
        "type": "object",
        "required": ["verdict", "severity", "confidence", "checks", "thresholds"],
        "properties": {
          "verdict": { "type": "string", "enum": ["pass", "review", "block"] },
          "severity": { "type": "number", "minimum": 0, "maximum": 2 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "checks": {
            "type": "object",
            "required": [
              "unusual_amount",
              "unusual_counterparty",
              "possible_duplicate",
              "urgency_pressure",
              "restricted_party"
            ],
            "properties": {
              "unusual_amount": { "type": "number", "minimum": 0, "maximum": 1 },
              "unusual_counterparty": { "type": "number", "minimum": 0, "maximum": 1 },
              "possible_duplicate": { "type": "number", "minimum": 0, "maximum": 1 },
              "urgency_pressure": { "type": "number", "minimum": 0, "maximum": 1 },
              "restricted_party": { "type": "number", "minimum": 0, "maximum": 1 }
            },
            "additionalProperties": false
          },
          "thresholds": {
            "type": "object",
            "required": ["block_at", "review_at"],
            "properties": {
              "block_at": { "type": "number", "minimum": 0, "maximum": 1 },
              "review_at": { "type": "number", "minimum": 0, "maximum": 1 }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      "priceUsdc": "0.08",
      "graceLatencyMs": 3000,
      "hardTimeoutMs": 12000,
      "maxRebateBps": 5000,
      "slashPenaltyBps": 2500,
      "providerBps": 7500,
      "initialBondUsdc": "0.03"
    }
  ]
}
